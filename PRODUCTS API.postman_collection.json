      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"title\": \"Laptop QA\",\r\n  \"description\": \"Producto de prueba\",\r\n  \"price\": 2500,\r\n  \"stock\": 15,\r\n  \"brand\": \"QA\",\r\n  \"category\": \"laptops\"\r\n}\r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/products/add",
          "host": [
