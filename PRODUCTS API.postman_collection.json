          ],
          "path": [
            "products",
            "add"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Actualizar producto",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "\r",
              "pm.test(\"Status code es 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"La respuesta no contiene errores\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.not.have.property(\"error\");\r",
              "});\r",
              "\r",
              "pm.test(\"El ID del producto es correcto\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.id).to.eql(1);\r",
              "});\r",
              "\r",
              "pm.test(\"El nombre fue actualizado\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.title).to.eql(\"Laptop QA Actualizada\");\r",
              "});\r",
              "\r",
              "pm.test(\"El precio fue actualizado\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.price).to.eql(3200);\r",
              "});\r",
              "\r",
              "pm.test(\"El stock fue actualizado\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.stock).to.eql(20);\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
